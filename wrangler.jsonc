{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketduel",
  "compatibility_date": "2026-11-20",
  "observability": {
    "enabled": true
  },
  // Static site: no Worker script, every request is served from web/.
  "assets": {
    "directory": "web/"
  },
  "routes": [
    { "pattern": "pocketduel.com", "custom_domain": true }
  ],
  // Only the custom domain serves the site.
  "workers_dev": false,
  "preview_urls": false
}
